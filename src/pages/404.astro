---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LAB_NAME } from '../data/lab';
import { url } from '../lib/url';
import '../styles/pages/404.css';
---

<Base title={`Page not found · ${LAB_NAME}`} description="That page does not exist.">
  <Header />

  <main id="main">
    <section class="notfound">
      <div class="shell">
        <span class="label">404</span>
        <h1>Page not found.</h1>
        <p>
          The page you asked for is not here. It may have moved, or it may be one of the old
          Squarespace course URLs that this rebuild did not keep.
        </p>
        <div class="link-row">
          <a href={url('/')}>Home →</a>
          <a href={url('/research')}>Research →</a>
          <a href={url('/publications')}>Publications →</a>
          <a href={url('/teaching')}>Teaching →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
