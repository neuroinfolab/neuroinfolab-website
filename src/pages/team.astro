---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import { site, LAB_NAME, piBio, links, EMAIL, SCHOLAR, TWITTER } from '../data/lab';
import { alumniImg, labLife, teamImg } from '../data/images';
import { url } from '../lib/url';
import '../styles/pages/team.css';
---

<Base title={`Team · ${LAB_NAME}`} description="People, alumni and lab life in the Neuroinformatics Lab at NYU Tandon.">
  <Header />

  <main id="main">
    <PageHead
      label="People"
      title="Team"
      lede="A computational lab working across imaging, genomics and electrophysiology — and the people who make it run."
    >
      <div class="link-row">
        <a href={url('/join')}>Join us →</a>
        <a href={url('/research')}>Research →</a>
      </div>
    </PageHead>

    <section class="section" id="pi" aria-labelledby="pi-title">
      <div class="shell">
        <div class="pi">
          <div>
            <span class="label">Principal investigator</span>
            <h2 id="pi-title">Erdem Varol</h2>
            <p class="pi-role">Assistant Professor · Computer Science &amp; Engineering</p>
            <div class="pi-bio prose" set:html={piBio} />
            <div class="pi-links">
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <a href={url(links.cv)}>CV</a>
              <a href={SCHOLAR} target="_blank" rel="noopener">Google Scholar</a>
              <a href={TWITTER} target="_blank" rel="noopener">X / Twitter</a>
            </div>
          </div>
          <div class="pi-photo">
            <img src={url('/img/team/varol.jpg')} alt="Erdem Varol" width="480" height="600" />
          </div>
        </div>

        <div class="group" id="members">
          <div class="group-head">
            <h3>Lab members</h3>
            <span>{site.team.length} people</span>
          </div>
          <div class="people people--team">
            {site.team.map((p) => (
              <div class="person">
                <div class="person-media">
                  {teamImg[p.name] ? (
                    <img src={url(teamImg[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                  ) : null}
                </div>
                <div class="person-name">
                  {p.site ? (
                    <a href={p.site} target="_blank" rel="noopener">{p.name}</a>
                  ) : (
                    p.name
                  )}
                </div>
                <div class="person-role">{p.role}</div>
                {p.note && <div class="person-note">{p.note}</div>}
                {p.prev && <div class="person-note">{p.prev}</div>}
              </div>
            ))}
          </div>
        </div>

        <div class="alumni" id="alumni">
          <h3>Alumni and students</h3>
          <div class="alumni-grid">
            {site.alumni.map((a) => (
              <div class="alum">
                <div class="alum-media">
                  {alumniImg[a.name] ? (
                    <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                  ) : null}
                </div>
                <div class="alum-name">
                  {a.site ? (
                    <a href={a.site} target="_blank" rel="noopener">{a.name}</a>
                  ) : (
                    a.name
                  )}
                </div>
                <div class="alum-role">{a.role}</div>
                {a.school && <div class="alum-role">{a.school}</div>}
              </div>
            ))}
          </div>
        </div>

        <div class="group" id="life">
          <div class="group-head">
            <h3>Lab life</h3>
            <span>Whiteboards, classes, outings</span>
          </div>
          <div class="gallery">
            {labLife.map((photo) => (
              <a href={url(`${photo.src}.jpg`)}>
                <img
                  src={url(`${photo.src}_sm.jpg`)}
                  alt={photo.alt}
                  loading="lazy"
                  width="720"
                  height="540"
                />
              </a>
            ))}
          </div>
          <p class="team-note">
            Outside the papers: lab meeting, the Neuroinformatics class project winners, and the occasional marathon.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
