---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PubList from '../components/PubList.astro';
import {
  site,
  LAB_NAME,
  piBio,
  featuredProjects,
  projects,
  publicationsByYear,
  shortSummary,
  links,
  EMAIL,
  SCHOLAR,
  TWITTER,
} from '../data/lab';
import { url } from '../lib/url';
import { alumniImg, teamImg } from '../data/images';
import '../styles/pages/home.css';

const latest = publicationsByYear[0];
const heroProject = projects.find((p) => p.title.startsWith('Spatiotemporal'));
---

<Base title={`${LAB_NAME} · NYU Tandon`} description={site.tagline}>
  <Header />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="shell">
        <div class="hero-inner">
          <div>
            <a class="hero-announce" href={url('/join')}>
              Ph.D. and postdoctoral positions are open <span aria-hidden="true">→</span>
            </a>
            <span class="label">Tandon School of Engineering, NYU</span>
            <h1 id="hero-title" class="display">{site.name}</h1>
            <p class="hero-lede">{site.tagline}</p>
            <div class="hero-actions">
              <a href={url('/research')}>Research →</a>
              <a href={url('/publications')}>Publications →</a>
              <a href={url('/team')}>Team →</a>
            </div>
            <p class="hero-meta">
              <span class="label">Led by Erdem Varol</span>
              <span class="label">Brooklyn, NY</span>
            </p>
          </div>

          <figure class="hero-media">
            <video
              src={url('/media/transcriptomics.mp4')}
              poster={url('/media/transcriptomics.jpg')}
              muted
              loop
              autoplay
              playsinline
              preload="metadata"
              aria-label="Spatiotemporal Integration of the Human Transcriptome and Connectome"
            ></video>
            <figcaption>
              {heroProject ? (
                <a href={url(heroProject.href)}>
                  Spatiotemporal Integration of the Human Transcriptome and Connectome
                </a>
              ) : (
                <span>Spatiotemporal Integration of the Human Transcriptome and Connectome</span>
              )}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="pi" aria-labelledby="pi-title">
      <div class="shell">
        <div class="pi">
          <div>
            <span class="label">Principal investigator</span>
            <h2 id="pi-title">Erdem Varol</h2>
            <p class="pi-role">Assistant Professor · Computer Science &amp; Engineering</p>
            <div class="pi-bio prose" set:html={piBio} />
            <div class="pi-links">
              <a href={`mailto:${EMAIL}`}>Email</a>
              <a href={url(links.cv)}>CV</a>
              <a href={SCHOLAR} target="_blank" rel="noopener">Google Scholar</a>
              <a href={TWITTER} target="_blank" rel="noopener">X / Twitter</a>
            </div>
          </div>
          <div class="pi-photo">
            <img src={url('/img/team/varol.jpg')} alt="Erdem Varol" width="480" height="600" />
          </div>
        </div>

        <div class="group">
          <div class="group-head">
            <h3>Lab members</h3>
            <span>{site.team.length} people</span>
            <a class="more" href={url('/team')}>Team and alumni →</a>
          </div>
          <div class="people">
            {site.team.map((p) => (
              <div class="person">
                <div class="person-media">
                  {teamImg[p.name] ? (
                    <img src={url(teamImg[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                  ) : null}
                </div>
                <div class="person-name">
                  {p.site ? (
                    <a href={p.site} target="_blank" rel="noopener">{p.name}</a>
                  ) : (
                    p.name
                  )}
                </div>
                <div class="person-role">{p.role}</div>
                {p.note && <div class="person-note">{p.note}</div>}
                {p.prev && <div class="person-note">{p.prev}</div>}
              </div>
            ))}
          </div>
        </div>

        <div class="alumni">
          <h3>Alumni</h3>
          <div class="alumni-grid">
            {site.alumni.map((a) => (
              <div class="alum">
                <div class="alum-media">
                  {alumniImg[a.name] ? (
                    <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                  ) : null}
                </div>
                <div class="alum-name">
                  {a.site ? (
                    <a href={a.site} target="_blank" rel="noopener">{a.name}</a>
                  ) : (
                    a.name
                  )}
                </div>
                <div class="alum-role">{a.role}</div>
                {a.school && <div class="alum-role">{a.school}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="projects-title">Research</h2>
          <a class="more" href={url('/research')}>All {projects.length} projects →</a>
        </div>

        <div class="projects">
          {featuredProjects.map((p) => (
            <ProjectCard
              href={url(p.href)}
              index={p.index}
              title={p.title}
              summary={shortSummary(p.title)}
              poster={p.poster ? url(p.poster) : null}
              collab={p.collabLinks}
            />
          ))}

          <a class="card card--more" href={url('/research')}>
            <div class="card-body">
              <span class="count">{projects.length}</span>
              <h3>All lab projects</h3>
              <p>From whole-brain transcriptomics to electrode localization and connectome-constrained networks.</p>
              <span class="collab">Research →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="publications" aria-labelledby="publications-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="publications-title">Recent publications</h2>
          <a class="more" href={url('/publications')}>All {site.publications.length} papers →</a>
        </div>

        <PubList groups={[latest]} compact />
      </div>
    </section>

    <section class="section" id="join" aria-labelledby="join-title">
      <div class="shell">
        <div class="home-join">
          <div>
            <span class="label">Funding</span>
            <p class="funding">{site.funding.join(' ')}</p>
            <img class="funding-logo" src={url('/img/nih-nimh.jpg')} alt="NIH National Institute of Mental Health" width="150" height="75" loading="lazy" />
          </div>
          <div>
            <span class="label">Join us</span>
            <h2 id="join-title">Ph.D. and postdoctoral positions are open.</h2>
            <p>
              We look for strong computational skills, an interest in applied neuroscience, and the
              curiosity to work across imaging, genomics and electrophysiology.
            </p>
            <div class="link-row">
              <a href={url('/join')}>Open positions →</a>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <a href={SCHOLAR} target="_blank" rel="noopener">Google Scholar</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
