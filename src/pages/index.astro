---

<Base title={site.name} description={site.tagline}>
  <Header />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell">
        <div class="hero-inner">
          <div>
            <h1 id="hero-title" class="display">{site.name}</h1>
            <p class="hero-lede">{site.tagline}</p>
            <p class="hero-apply">
              Apply for Ph.D. student and postdoctoral positions now <a href={url('/#openings')}>(see below).</a>
            </p>
          </div>

          <figure
            class="hero-media"
            data-hero-carousel
            aria-roledescription="carousel"
            aria-label="Lab imaging loops"
          >
            <div class="hero-media-stage">
              {motion.map((item, i) => (
                <video
                  class:list={['hero-slide', { 'is-active': i === 0 }]}
                  data-hero-slide
                  data-caption={item.caption}
                  data-label={item.label}
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? 'auto' : 'none'}
                  poster={url(item.poster)}
                  aria-label={item.alt}
                  width="1280"
                  height="720"
                >
                  <source src={url(item.webm)} type="video/webm" />
                  <source src={url(item.mp4)} type="video/mp4" />
                </video>
              ))}

              <button class="hero-arrow hero-arrow--prev" type="button" data-hero-prev aria-label="Previous imaging loop">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <button class="hero-arrow hero-arrow--next" type="button" data-hero-next aria-label="Next imaging loop">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>

              <div class="hero-dots" role="group" aria-label="Choose an imaging loop">
                {motion.map((item, i) => (
                  <button
                    class="hero-dot"
                    type="button"
                    data-hero-dot
                    aria-label={`Show ${item.label}`}
                    aria-current={i === 0 ? 'true' : undefined}
                  ></button>
                ))}
              </div>
            </div>

            <figcaption>
              <span data-hero-caption>{motion[0].caption}</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="pi" aria-labelledby="pi-title">
      <div class="shell">
        <div class="pi">
          <div>
            <h2 id="pi-title">{site.pi.name}</h2>
            <p class="pi-bio">{site.pi.bio}</p>
            <div class="pi-links">
              <a href="mailto:ev2240@nyu.edu">Email: ev2240@nyu.edu</a>
              <a href={url('/docs/varol_cv_1122.pdf')} target="_blank" rel="noopener noreferrer">CV</a>
              <a href="https://scholar.google.com/citations?user=7GlElV0AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
              <a href="https://twitter.com/erdem___varol" target="_blank" rel="noopener noreferrer">Twitter</a>
            </div>
          </div>
          <div class="pi-photo" data-parallax>
            <img src={url('/img/team/varol.jpg')} alt={site.pi.name} width="480" height="600" />
          </div>
        </div>

        <div class="group">
          <div class="group-head">
            <h3>Team</h3>
          </div>
          <div class="people">
            {site.team.map((p) => (
              <div class="person">
                <div class="person-media">
                  {people[p.name] ? (
                    p.site ? (
                      <a href={p.site} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} website`}>
                        <img src={url(people[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                      </a>
                    ) : (
                      <img src={url(people[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                    )
                  ) : null}
                </div>
                <div class="person-name">
                  {p.site ? (
                    <a href={p.site} target="_blank" rel="noopener">{p.name}</a>
                  ) : (
                    p.name
                  )}
                </div>
                <div class="person-role">{p.role}</div>
                {p.note && <div class="person-note">{p.note}</div>}
                {p.prev && <div class="person-note">{p.prev}</div>}
              </div>
            ))}
          </div>
        </div>

        <div class="alumni">
          <h3>Alumni</h3>
          <div class="alumni-grid">
            {site.alumni.map((a) => (
              <div class="alum">
                <div class="alum-media">
                  {alumniImg[a.name] ? (
                    a.site ? (
                      <a href={a.site} target="_blank" rel="noopener noreferrer" aria-label={`${a.name} website`}>
                        <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                      </a>
                    ) : (
                      <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                    )
                  ) : null}
                </div>
                <div class="alum-name">
                  {a.site ? (
                    <a href={a.site} target="_blank" rel="noopener">{a.name}</a>
                  ) : (
                    a.name
                  )}
                </div>
                <div class="alum-role">{a.role}</div>
                {a.school && <div class="alum-role">{a.school}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="life" aria-labelledby="life-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="life-title">Lab life</h2>
        </div>

        <ul class="gallery">
          {life.map((photo) => (
            <li>
              <a href={url(photo.full)} target="_blank" rel="noopener noreferrer">
                <img
                  src={url(photo.thumb)}
                  alt={photo.alt}
                  loading="lazy"
                  width="720"
                  height="540"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="publications" aria-labelledby="publications-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="publications-title">Publications</h2>
          <a class="more" href="https://scholar.google.com/citations?user=7GlElV0AAAAJ">
            Link to Google Scholar →
          </a>
        </div>

        {featuredGroups.map((group) => (
          <section class="pub-group" aria-labelledby={`pub-topic-${group.id}`}>
            <h3 class="pub-topic-head" id={`pub-topic-${group.id}`}>{group.label}</h3>
            <div class="pub-featured">
              {group.papers.map((item) => {
                const p = item.publication;
                const href = p ? linkFor(p) : null;
                return (
                  <article class="pub-feature">
                    <div class="pub-feature-media">
                      {href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                          <img
                            src={url(item.image)}
                            alt={item.alt}
                            loading="lazy"
                            width="600"
                            height="600"
                          />
                        </a>
                      ) : (
                        <img
                          src={url(item.image)}
                          alt={item.alt}
                          loading="lazy"
                          width="600"
                          height="600"
                        />
                      )}
                    </div>
                    <div class="pub-feature-body">
                      <h3 class="pub-feature-title">
                        {href ? (
                          <a href={href} target="_blank" rel="noopener noreferrer">
                            {p?.title ?? item.title}
                          </a>
                        ) : (
                          p?.title ?? item.title
                        )}
                      </h3>
                      {p && (
                        <p class="pub-feature-authors">
                          {authorNames(p.authors).map((name, i) => (
                            <>
                              {i > 0 ? ', ' : ''}
                              {varol.test(name) ? <strong>{name}</strong> : name}
                            </>
                          ))}
                        </p>
                      )}
                      {p && (
                        <p class="pub-feature-venue">
                          {venueLabel(p)}
                          {p.note && <span class="pub-feature-note"> · {p.note}</span>}
                        </p>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}

        <details class="pub-archive" data-rollout>
          <summary class="pub-archive-head">
            <span>See full list</span>
          </summary>
          <div class="pubs" data-rollout-body>
            {byYear.map((group) => (
              <details class="pub-year-group" data-rollout>
                <summary class="pub-year-head">{group.year}</summary>
                <div class="pub-year-body" data-rollout-body>
                  {group.items.map((p) => {
                    const href = linkFor(p);
                    const doi = doiFor(p);
                    return (
                      <article class="pub" title={`${p.title} — ${p.authors} — ${p.venue}`}>
                        <p class="pub-line">
                          {p.note && (
                            <span class="pub-star" title={p.note} aria-label={p.note} role="img">
                              <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path
                                  d="M8 1.4 9.9 5.3l4.3.6-3.1 3 .7 4.3L8 11.2l-3.8 2 .7-4.3-3.1-3 4.3-.6L8 1.4Z"
                                  fill="currentColor"
                                />
                              </svg>
                            </span>
                          )}
                          {href ? (
                            <a
                              class="pub-title"
                              href={href}
                              target="_blank"
                              rel="noopener noreferrer"
                              title={p.url ? 'Open paper' : `Open DOI: ${doi}`}
                            >
                              {p.title}
                            </a>
                          ) : (
                            <span class="pub-title">{p.title}</span>
                          )}
                          <span class="pub-sep">·</span>
                          <span class="pub-authors">
                            {authorNames(p.authors).map((name, i) => (
                              <>
                                {i > 0 ? ', ' : ''}
                                {varol.test(name) ? <strong>{name}</strong> : name}
                              </>
                            ))}
                          </span>
                          <span class="pub-sep">·</span>
                          <span class="pub-venue">{venueLabel(p)}</span>
                        </p>
                      </article>
                    );
                  })}
                </div>
              </details>
            ))}
          </div>
        </details>
      </div>
    </section>

    <section class="section" id="funding" aria-labelledby="funding-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="funding-title">Funding sources</h2>
        </div>
        {site.funding.map((f) => (
          <p class="funding">
            <a href={f.url} target="_blank" rel="noopener noreferrer">{f.text}</a>
          </p>
        ))}
      </div>
    </section>

    <section class="section" id="openings" aria-labelledby="openings-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="openings-title">Job openings</h2>
        </div>

        <div class="openings">
          <article class="opening">
            <h3>Ph.D. student openings</h3>
            <p>
              <strong>Requirements:</strong> Qualified Ph.D. student candidates should have strong computational
              skills and a Bachelor of Science degree (or equivalent) from backgrounds such as computer science,
              electrical engineering, statistics and biomedical engineering as well as an interest in applied
              neuroscience problems.
            </p>
            <p>
              <strong>Application process:</strong> Applications will need to be submitted to the NYU Computer
              Science Ph.D. program <a href="https://cs.nyu.edu/dynamic/phd/admissions/" target="_blank" rel="noopener noreferrer">online portal</a>,
              denoting the preference to work with Dr. Varol’s group. For 2025, the Ph.D. program application
              deadline for Fall matriculation is Dec. 12.
            </p>
          </article>

          <article class="opening">
            <h3>Postdoctoral fellow openings</h3>
            <p>
              <a href={url('/docs/nyu_utsw_postdoc_ad.pdf')} target="_blank" rel="noopener noreferrer">
                Joint NYU/UTSW Computational Systems Neuroscience Postdoctoral Research Scientist position
              </a>{' '}
              (Posted December 1 2025)
            </p>
          </article>

          <article class="opening">
            <h3>Other research openings</h3>
            <p>
              Review our website and indicate research interest via the below form and we will get in touch.
              Must be a current NYU student.
            </p>
            <p>
              <a href="https://forms.gle/BrtJcpdfhE7TJSoQ9" target="_blank" rel="noopener noreferrer">
                https://forms.gle/BrtJcpdfhE7TJSoQ9
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const carousel = document.querySelector('[data-hero-carousel]');

    if (carousel) {
      const slides = [...carousel.querySelectorAll('[data-hero-slide]')];
      const caption = carousel.querySelector('[data-hero-caption]');
      const dots = [...carousel.querySelectorAll('[data-hero-dot]')];
      const prev = carousel.querySelector('[data-hero-prev]');
      const next = carousel.querySelector('[data-hero-next]');

      if (slides.length && caption && dots.length) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let index = 0;
        let timer = 0;
        let focused = false;

        const isPaused = () => reduced || focused || document.hidden;

        const preloadNext = () => {
          const upcoming = slides[(index + 1) % slides.length];
          if (upcoming.preload === 'none') upcoming.preload = 'auto';
        };

        const update = () => {
          const slide = slides[index];
          caption.textContent = slide.dataset.caption || '';

          slides.forEach((video, i) => {
            const active = i === index;
            video.classList.toggle('is-active', active);
            if (active && !isPaused()) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });

          dots.forEach((dot, i) => {
            if (i === index) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });

          preloadNext();
        };

        const schedule = () => {
          window.clearTimeout(timer);
          update();
          if (isPaused()) return;
          timer = window.setTimeout(() => {
            index = (index + 1) % slides.length;
            schedule();
          }, 7000);
        };

        const go = (i) => {
          index = (i + slides.length) % slides.length;
          schedule();
        };

        prev?.addEventListener('click', (event) => {
          go(index - 1);
          if (event.detail > 0) prev?.blur();
        });
        next?.addEventListener('click', (event) => {
          go(index + 1);
          if (event.detail > 0) next?.blur();
        });
        dots.forEach((dot, i) =>
          dot.addEventListener('click', (event) => {
            go(i);
            if (event.detail > 0) dot.blur();
          }),
        );

        carousel.addEventListener('focusin', () => {
          focused = true;
          schedule();
        });
        carousel.addEventListener('focusout', (event) => {
          if (!carousel.contains(event.relatedTarget)) {
            focused = false;
            schedule();
          }
        });
        document.addEventListener('visibilitychange', schedule);

        window.setTimeout(preloadNext, 2000);
        schedule();
      }
    }
  </script>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

    document.querySelectorAll('details[data-rollout]').forEach((details) => {
      const summary = details.querySelector(':scope > summary');
      const body = details.querySelector(':scope > [data-rollout-body]');
      if (!summary || !body) return;

      details.classList.add('rollout-ready');

      let expanded = details.hasAttribute('open');
      let run = 0;
      let endTimer = 0;

      const settle = () => {
        window.clearTimeout(endTimer);
        body.classList.remove('is-rolling');
        body.style.removeProperty('height');
        body.style.removeProperty('--rollout-duration');
        body.style.removeProperty('--rollout-ease');
      };

      const toggle = () => {
        const myRun = ++run;
        expanded = !expanded;

        const from = body.getBoundingClientRect().height;

        // Freeze at the current pixel height so a re-click mid-flight
        // reverses from where the animation actually is.
        window.clearTimeout(endTimer);
        body.classList.remove('is-rolling');
        body.style.height = `${from}px`;
        void body.offsetHeight;

        if (reduceMotion.matches) {
          details.toggleAttribute('open', expanded);
          settle();
          return;
        }

        let to = 0;
        if (expanded) {
          details.setAttribute('open', '');
          // Measure at auto height: overflow-y: clip has no scroll box, so
          // scrollHeight is not reliable here. This happens before paint.
          body.style.height = 'auto';
          to = body.getBoundingClientRect().height;
          body.style.height = `${from}px`;
          void body.offsetHeight;
        }
        const distance = Math.abs(to - from);
        // Longer lists get a little more travel time; year groups stay snappy.
        const duration = expanded
          ? clamp(320 + Math.sqrt(distance) * 6, 320, 640)
          : clamp(220 + Math.sqrt(distance) * 4, 220, 420);

        body.style.setProperty('--rollout-duration', `${Math.round(duration)}ms`);
        body.style.setProperty(
          '--rollout-ease',
          expanded ? 'cubic-bezier(0.22, 1, 0.36, 1)' : 'cubic-bezier(0.55, 0, 0.55, 0.2)',
        );

        const done = () => {
          if (myRun !== run) return;
          if (!expanded) details.removeAttribute('open');
          settle();
        };

        const onEnd = (event) => {
          if (event.target !== body || event.propertyName !== 'height') return;
          body.removeEventListener('transitionend', onEnd);
          done();
        };

        body.addEventListener('transitionend', onEnd);
        endTimer = window.setTimeout(() => {
          body.removeEventListener('transitionend', onEnd);
          done();
        }, duration + 90);

        body.classList.add('is-rolling');
        void body.offsetHeight;
        body.style.height = `${to}px`;
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        toggle();
      });
    });
  </script>
</Base>
