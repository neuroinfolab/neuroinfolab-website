---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import doiData from '../data/dois.json';
import { url } from '../lib/url';

const projects = site.projects;

const dois = doiData as Record<string, { doi: string }>;
const normalizeTitle = (value: string) =>
  value.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
const doiFor = (title: string) => dois[normalizeTitle(title)]?.doi;
const splitAuthors = (authors: string) => authors.split(/(E(?:rdem)?\.?\s+Varol)/g);
const isVarol = (part: string) => /^E(?:rdem)?\.?\s+Varol$/.test(part);

const years = [...new Set(site.publications.map((p) => p.year))];
const byYear = years.map((y) => ({
  year: y,
  items: site.publications.filter((p) => p.year === y),
}));

const alumniImg: Record<string, string> = {
  'Chenyi Li': '/img/alumni/li.jpg',
  'Rohaan Advani': '/img/alumni/advani.jpg',
  'Aditya Chichgare': '/img/alumni/chichgare.jpg',
  'Allen Hung': '/img/alumni/hung.jpg',
  'Justin Hwang': '/img/alumni/hwang.jpg',
  'Rishabh Raj': '/img/alumni/raj.jpg',
  'Chinmayan Pradeep': '/img/alumni/pradeep.jpg',
  'Akshat Sachin Shaha': '/img/alumni/shaha.jpg',
  'Malhar Patel': '/img/alumni/patel.jpg',
  'Daniela Shoham': '/img/alumni/shoham.jpg',
  'Rosanne Cui': '/img/alumni/cui.jpg',
  'Anusha Kumar': '/img/alumni/kumar.jpg',
};

const people: Record<string, string> = {
  'Alex Ratzan': '/img/team/ratzan.jpg',
  'Tianxiao He': '/img/team/he.jpg',
  'Margaret Conde Paredes': '/img/team/conde-paredes.jpg',
  'Sid Goel': '/img/team/goel.jpg',
  'Visweswar Sirish Parupudi': '/img/team/parupudi.jpg',
  'Nalini Ramanathan': '/img/team/ramanathan.jpg',
  'Lawrence Lu': '/img/team/lu.jpg',
  'Subhrajit Dey': '/img/team/dey.jpg',
  'Sherlock & Toby the Basset Hounds': '/img/team/sherlock-toby.jpg',
};

const life = [
  {
    full: '/img/life/whiteboard-1.jpg',
    thumb: '/img/life/whiteboard-1_sm.jpg',
    alt: 'Working at the whiteboard in the lab',
  },
  {
    full: '/img/life/class-winners-1.jpg',
    thumb: '/img/life/class-winners-1_sm.jpg',
    alt: 'Neuroinformatics class: Project 1 winners',
  },
  {
    full: '/img/life/pumpkins.jpg',
    thumb: '/img/life/pumpkins_sm.jpg',
    alt: 'Lab outing: pumpkin picking',
  },
  {
    full: '/img/life/whiteboard-3.jpg',
    thumb: '/img/life/whiteboard-3_sm.jpg',
    alt: 'Derivations on the lab whiteboard',
  },
  {
    full: '/img/life/lab-meeting.jpg',
    thumb: '/img/life/lab-meeting_sm.jpg',
    alt: 'Lab meeting with pastries',
  },
  {
    full: '/img/life/picnic.jpg',
    thumb: '/img/life/picnic_sm.jpg',
    alt: 'Lab picnic',
  },
  {
    full: '/img/life/whiteboard-2.jpg',
    thumb: '/img/life/whiteboard-2_sm.jpg',
    alt: 'Lab discussion around the whiteboard',
  },
  {
    full: '/img/life/class-winners-2.jpg',
    thumb: '/img/life/class-winners-2_sm.jpg',
    alt: 'Neuroinformatics class: Project 2 winners',
  },
  {
    full: '/img/life/lab-meeting-2.jpg',
    thumb: '/img/life/lab-meeting-2_sm.jpg',
    alt: 'Lab meeting at 370 Jay Street',
  },
  {
    full: '/img/life/marathon.jpg',
    thumb: '/img/life/marathon_sm.jpg',
    alt: 'Erdem with his marathon medal',
  },
];
---

<Base title={site.name} description={site.tagline}>
  <Header />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell">
        <div class="hero-inner">
          <div>
            <span class="label">Tandon School of Engineering, NYU</span>
            <h1 id="hero-title" class="display" style="margin-top:1rem">{site.name}</h1>
            <p class="hero-lede">{site.tagline}</p>
          </div>

          <figure class="hero-media">
            <video
              src={url('/media/transcriptomics.mp4')}
              poster={url('/media/transcriptomics.jpg')}
              muted
              loop
              autoplay
              playsinline
              preload="metadata"
              aria-label="Spatiotemporal Integration of the Human Transcriptome and Connectome"
            ></video>
            <figcaption>
              <span>Spatiotemporal Integration of the Human Transcriptome and Connectome</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="pi" aria-labelledby="pi-title">
      <div class="shell">
        <div class="pi">
          <div>
            <span class="label">Principal investigator</span>
            <h2 id="pi-title">{site.pi.name}</h2>
            <p class="pi-bio">{site.pi.bio}</p>
            <div class="pi-links">
              <a href="mailto:ev2240@nyu.edu">Email: ev2240@nyu.edu</a>
              <a href={url('/docs/varol_cv_1122.pdf')} target="_blank" rel="noopener noreferrer">CV</a>
              <a href="https://scholar.google.com/citations?user=7GlElV0AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
              <a href="https://twitter.com/erdem___varol" target="_blank" rel="noopener noreferrer">Twitter</a>
            </div>
          </div>
          <div class="pi-photo">
            <img src={url('/img/team/varol.jpg')} alt={site.pi.name} width="480" height="600" />
          </div>
        </div>

        <div class="group">
          <div class="group-head">
            <h3>Team</h3>
          </div>
          <div class="people">
            {site.team.map((p) => (
              <div class="person">
                <div class="person-media">
                  {people[p.name] ? (
                    p.site ? (
                      <a href={p.site} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} website`}>
                        <img src={url(people[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                      </a>
                    ) : (
                      <img src={url(people[p.name])} alt={p.name} loading="lazy" width="480" height="600" />
                    )
                  ) : null}
                </div>
                <div class="person-name">
                  {p.site ? (
                    <a href={p.site} target="_blank" rel="noopener">{p.name}</a>
                  ) : (
                    p.name
                  )}
                </div>
                <div class="person-role">{p.role}</div>
                {p.note && <div class="person-note">{p.note}</div>}
                {p.prev && <div class="person-note">{p.prev}</div>}
              </div>
            ))}
          </div>
        </div>

        <div class="alumni">
          <h3>Alumni</h3>
          <div class="alumni-grid">
            {site.alumni.map((a) => (
              <div class="alum">
                <div class="alum-media">
                  {alumniImg[a.name] ? (
                    a.site ? (
                      <a href={a.site} target="_blank" rel="noopener noreferrer" aria-label={`${a.name} website`}>
                        <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                      </a>
                    ) : (
                      <img src={url(alumniImg[a.name])} alt={a.name} loading="lazy" width="480" height="600" />
                    )
                  ) : null}
                </div>
                <div class="alum-name">
                  {a.site ? (
                    <a href={a.site} target="_blank" rel="noopener">{a.name}</a>
                  ) : (
                    a.name
                  )}
                </div>
                <div class="alum-role">{a.role}</div>
                {a.school && <div class="alum-role">{a.school}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="life" aria-labelledby="life-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="life-title">Lab life</h2>
        </div>

        <ul class="gallery">
          {life.map((photo) => (
            <li>
              <a href={url(photo.full)} target="_blank" rel="noopener noreferrer">
                <img
                  src={url(photo.thumb)}
                  alt={photo.alt}
                  loading="lazy"
                  width="720"
                  height="540"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="projects-title">Lab Projects</h2>
        </div>

        <div class="projects">
          {projects.map((p, i) => (
            <ProjectCard
              index={String(i + 1).padStart(2, '0')}
              title={p.title}
              summary={p.desc}
              poster={p.poster ? url(p.poster) : null}
              collab={p.collab}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="publications" aria-labelledby="publications-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="publications-title">Publications</h2>
          <a class="more" href="https://scholar.google.com/citations?user=7GlElV0AAAAJ">
            Link to Google Scholar →
          </a>
        </div>

        <div class="pubs">
          {byYear.map((group) => (
            <section class="pub-year-group">
              <h3 class="pub-year-head">{group.year}</h3>
              {group.items.map((p) => {
                const doi = doiFor(p.title);
                return (
                  <article class="pub" title={`${p.title} — ${p.authors} — ${p.venue}`}>
                    <p class="pub-line">
                      {doi ? (
                        <a
                          class="pub-title"
                          href={`https://doi.org/${doi}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`Open DOI: ${doi}`}
                        >
                          {p.title}
                        </a>
                      ) : (
                        <span class="pub-title">{p.title}</span>
                      )}
                      <span class="pub-sep">·</span>
                      <span class="pub-authors">
                        {splitAuthors(p.authors).map((part) => (isVarol(part) ? <strong>{part}</strong> : part))}
                      </span>
                      <span class="pub-sep">·</span>
                      <span class="pub-venue">{p.venue}</span>
                    </p>
                  </article>
                );
              })}
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="funding" aria-labelledby="funding-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="funding-title">Funding sources</h2>
        </div>
        {site.funding.map((f) => (
          <p class="funding">
            <a href={f.url} target="_blank" rel="noopener noreferrer">{f.text}</a>
          </p>
        ))}
      </div>
    </section>

    <section class="section" id="openings" aria-labelledby="openings-title">
      <div class="shell">
        <div class="section-head">
          <h2 id="openings-title">Job openings</h2>
        </div>

        <div class="openings">
          <article class="opening">
            <h3>Ph.D. student openings</h3>
            <p>
              <strong>Requirements:</strong> Qualified Ph.D. student candidates should have strong computational
              skills and a Bachelor of Science degree (or equivalent) from backgrounds such as computer science,
              electrical engineering, statistics and biomedical engineering as well as an interest in applied
              neuroscience problems.
            </p>
            <p>
              <strong>Application process:</strong> Applications will need to be submitted to the NYU Computer
              Science Ph.D. program <a href="https://cs.nyu.edu/dynamic/phd/admissions/" target="_blank" rel="noopener noreferrer">online portal</a>,
              denoting the preference to work with Dr. Varol’s group. For 2025, the Ph.D. program application
              deadline for Fall matriculation is Dec. 12.
            </p>
          </article>

          <article class="opening">
            <h3>Postdoctoral fellow openings</h3>
            <p>
              <a href={url('/docs/nyu_utsw_postdoc_ad.pdf')} target="_blank" rel="noopener noreferrer">
                Joint NYU/UTSW Computational Systems Neuroscience Postdoctoral Research Scientist position
              </a>{' '}
              (Posted December 1 2025)
            </p>
          </article>

          <article class="opening">
            <h3>Other research openings</h3>
            <p>
              Review our website and indicate research interest via the below form and we will get in touch.
              Must be a current NYU student.
            </p>
            <p>
              <a href="https://forms.gle/BrtJcpdfhE7TJSoQ9" target="_blank" rel="noopener noreferrer">
                https://forms.gle/BrtJcpdfhE7TJSoQ9
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
