import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import doiData from '../data/dois.json';
import featuredData from '../data/featured-publications.json';
import { url } from '../lib/url';

type Publication = {
  year: string;
  title: string;
  authors: string;
  venue: string;
  venueShort?: string;
  doi?: string;
  url?: string;
  note?: string;
};

const publications = site.publications as Publication[];
const dois = doiData as Record<string, { doi: string }>;
const normalizeTitle = (value: string) =>
  value.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
// Per-entry DOI/URL overrides win over the title-keyed dois.json lookup.
const doiFor = (publication: Publication) =>
  publication.doi ?? dois[normalizeTitle(publication.title)]?.doi;
const linkFor = (publication: Publication) => {
  if (publication.url) return publication.url;
  const doi = doiFor(publication);
  // 10.52202 is Curran Associates; it resolves to proceedings.com, not the
  // official NeurIPS proceedings. Those entries carry an explicit url instead.
  if (!doi || doi.startsWith('10.52202/')) return null;
  return `https://doi.org/${doi}`;
};

// Keep E Varol visible when a long author list has to be shortened.
const varol = /^E(?:rdem)?\.?\s+Varol$/;
const authorNames = (authors: string) => {
  const names = authors
    .split(',')
    .map((name) => name.trim())
    .filter((name) => name && !/^[.…]+$/.test(name));
  const varolAt = names.findIndex((name) => varol.test(name));
  if (varolAt === -1) return names.length > 4 ? [...names.slice(0, 3), '…'] : names;
  if (names.length <= 5) return names;
  if (varolAt < 3) return [...names.slice(0, 3), '…'];
  return [...names.slice(0, 3), '…', names[varolAt]];
};

// Short journal/venue labels with the year, per the 2026-11-12 decision.
// The full venue remains in the row tooltip.
const venueLabel = (publication: Publication) => {
  if (publication.venueShort) return publication.venueShort;
  let label = publication.venue.split(';')[0].split(',')[0].trim();
  label = label.replace(/arxiv:\d+\.\d+/i, '').trim();
  const embeddedYear = label.match(/\b(19|20)\d{2}\b/)?.[0];

  const shortNames: Array<[RegExp, string]> = [
    [/^international conference on information processing in medical imaging/i, 'IPMI'],
    [/^icassp\b/i, 'ICASSP'],
    [/^international conference on medical image computing/i, 'MICCAI'],
    [/^proceedings of the ieee\/cvf winter conference on applications of computer/i, 'WACV'],
    [/international symposium on biomedical imaging/i, 'ISBI'],
    [/^symposium on advances in approximate bayesian inference/i, 'AABI'],
    [/^arxiv\b/i, 'arXiv'],
    [/^elsevier science inc/i, 'Elsevier'],
  ];
  for (const [pattern, short] of shortNames) {
    if (pattern.test(label)) {
      label = short;
      break;
    }
  }

  label = label
    .replace(/\s+\d+\s*\(\s*suppl[^)]*\)\s*$/i, '')
    .replace(/\s+\d+\s*\(\d+\)\s*$/, '')
    .replace(/\s+\d+\s*$/, '')
    .trim();

  if (embeddedYear) {
    if (!label.includes(embeddedYear)) label = `${label} ${embeddedYear}`;
  } else if (/^\d{4}$/.test(publication.year) && !/(19|20)\d{2}/.test(label)) {
    label = `${label} ${publication.year}`;
  }
  return label;
};

const years = [...new Set(publications.map((p) => p.year))];
const byYear = years.map((y) => ({
  year: y,
  items: publications.filter((p) => p.year === y),
}));

type FeaturedTopic = { id: string; label: string };
type FeaturedPaper = {
  topic?: string;
  topics?: string[];
  title: string;
  image: string;
  alt: string;
};
const featuredTopics = featuredData.topics as FeaturedTopic[];
const featured = (featuredData.papers as FeaturedPaper[])
  .map((paper, index) => ({
    title: paper.title,
    image: paper.image,
    alt: paper.alt,
    topics: paper.topics ?? (paper.topic ? [paper.topic] : []),
    index,
    publication: publications.find(
      (p) => normalizeTitle(p.title) === normalizeTitle(paper.title)
    ),
  }))
  .sort((a, b) => {
    const yearA = Number(a.publication?.year) || 0;
    const yearB = Number(b.publication?.year) || 0;
    return yearB - yearA || a.index - b.index;
  });
const featuredGroups = featuredTopics
  .map((topic) => ({
    ...topic,
    papers: featured.filter((paper) => paper.topics.includes(topic.id)),
  }))
  .filter((group) => group.papers.length > 0);

const alumniImg: Record<string, string> = {
