---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import { LAB_NAME, links, EMAIL, SCHOLAR } from '../data/lab';
import { url } from '../lib/url';
import '../styles/pages/join.css';
---

<Base
  title={`Join us · ${LAB_NAME}`}
  description="Open Ph.D., postdoctoral and student research positions in the Neuroinformatics Lab at NYU Tandon."
>
  <Header />

  <main id="main">
    <PageHead
      label="Join us"
      title="Come work on how the brain is wired."
      lede="We are looking for Ph.D. students and postdocs with strong computational skills and an interest in neuroscience. Neuroscience background is not required; curiosity and evidence of independent work are."
    >
      <div class="link-row">
        <a href={url('/research')}>Read about our research →</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={SCHOLAR} target="_blank" rel="noopener">Google Scholar</a>
      </div>
    </PageHead>

    <section class="section">
      <div class="shell">
        <div class="openings">
          <article class="opening" id="phd">
            <div>
              <h2>Ph.D. students</h2>
              <span class="opening-kicker">NYU CS Ph.D. program</span>
            </div>
            <div class="opening-body">
              <p>
                Qualified Ph.D. student candidates should have strong computational skills and a
                Bachelor of Science degree (or equivalent) from backgrounds such as computer science,
                electrical engineering, statistics and biomedical engineering, as well as an interest
                in applied neuroscience problems.
              </p>
              <p>
                Applications are submitted through the
                <a href={links.phdAdmissions} target="_blank" rel="noopener">NYU Computer Science Ph.D. program online portal</a>,
                denoting the preference to work with Dr. Varol’s group. For Fall matriculation, the
                Ph.D. program application deadline is December 12.
              </p>
            </div>
          </article>

          <article class="opening" id="postdoc">
            <div>
              <h2>Postdoctoral fellows</h2>
              <span class="opening-kicker">Joint NYU / UTSW</span>
            </div>
            <div class="opening-body">
              <p>
                Joint NYU/UTSW Computational Systems Neuroscience Postdoctoral Research Scientist
                position (posted December 1, 2025).
              </p>
              <p>
                <a href={url(links.postdocAd)}>Position description (PDF) →</a>
              </p>
            </div>
          </article>

          <article class="opening" id="students">
            <div>
              <h2>Current NYU students</h2>
              <span class="opening-kicker">Research and thesis projects</span>
            </div>
            <div class="opening-body">
              <p>
                If you are already at NYU and want to do a rotation, thesis or paid research project,
                read about our <a href={url('/research')}>research</a>, then tell us your interests
                through the <a href={links.interestForm} target="_blank" rel="noopener">interest form</a>.
                We will get in touch.
              </p>
            </div>
          </article>
        </div>

        <p class="join-note">
          The lab is supported by the NIH/NIMH K99/R00 award “Transcriptional basis of neural
          architectures” (1K99MH128772-01A1), 2022–2027. For anything not covered here, email
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
