---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

export interface CourseLink {
  label: string;
  href: string;
}

export interface CourseInfo {
  label: string;
  text: string;
  href?: string;
  links?: CourseLink[];
}

export interface CoursePerson {
  role: string;
  name: string;
  email?: string;
  office?: string;
  officeAfter?: string;
  image?: string;
  links?: CourseLink[];
}

export interface CourseRow {
  date: string;
  topic: string;
  materials?: CourseLink[];
  note?: string;
}

export interface ReadingGroup {
  title: string;
  items: Array<{ text: string; href?: string }>;
}

export interface CourseSection {
  title: string;
  paragraphs: string[];
  links?: CourseLink[];
  list?: string[];
}

interface CourseImage {
  src: string;
  srcSmall?: string;
  webp?: string;
  webpSmall?: string;
  alt: string;
  caption?: string;
  creditHref?: string;
  tone?: 'light';
}

interface Props {
  title: string;
  code: string;
  term: string;
  image?: CourseImage;
  intro: string[];
  info: CourseInfo[];
  team: CoursePerson[];
  sections?: CourseSection[];
  schedule: CourseRow[];
  readings: ReadingGroup[];
  previous?: CourseLink;
}

const { title, code, term, image, intro, info, team, sections = [], schedule, readings, previous } = Astro.props;
const href = (value: string) => (value.startsWith('/') ? url(value) : value);
const description = intro[0] ?? '';
---

<Base title={`${title} (${code}) — ${term}`} description={description}>
  <Header />

  <main id="main" class="course-page">
    <section class="course-head">
      <div class:list={['shell', 'course-head-inner', { 'course-head-inner--solo': !image }]}>
        <div class="course-head-copy">
          <span class="label">Course · {term}</span>
          <h1>{title}</h1>
          <p class="course-code">{code}</p>
        </div>
        {image && (
          <figure class:list={['course-head-media', { 'course-head-media--light': image.tone === 'light' }]}>
            <picture>
              {image.webp && (
                <source media="(max-width: 700px)" type="image/webp" srcset={href(image.webpSmall ?? image.webp)} />
              )}
              {image.webp && <source type="image/webp" srcset={href(image.webp)} />}
              {image.srcSmall && <source media="(max-width: 700px)" srcset={href(image.srcSmall)} />}
              <img src={href(image.src)} alt={image.alt} width="1400" height="1036" />
            </picture>
            {image.caption && (
              <figcaption>
                <span>
                  {image.creditHref ? (
                    <a href={image.creditHref} target="_blank" rel="noopener noreferrer">{image.caption}</a>
                  ) : (
                    image.caption
                  )}
                </span>
              </figcaption>
            )}
          </figure>
        )}
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="course-intro">
          {intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-head">
          <h2>Course information</h2>
        </div>
        <dl class="course-info">
          {info.map((item) => (
            <div class="course-info-row">
              <dt>{item.label}</dt>
              <dd>
                {item.href ? <a href={href(item.href)}>{item.text}</a> : item.text}
                {item.links?.map((link) => (
                  <>
                    {' '}
                    <a href={href(link.href)}>{link.label}</a>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-head">
          <h2>Course team</h2>
        </div>
        <div class="course-team">
          {team.map((person) => (
            <div class="course-person">
              {person.image && (
                <div class="course-person-media">
                  <img src={href(person.image)} alt={person.name} loading="lazy" width="480" height="600" />
                </div>
              )}
              <span class="role">{person.role}</span>
              <span class="name">{person.name}</span>
              {person.email && (
                <span class="meta">
                  <a href={`mailto:${person.email}`}>{person.email}</a>
                </span>
              )}
              {person.office && (
                <span class="meta">
                  {person.office}
                  {person.links?.map((link) => (
                    <>
                      {' '}
                      <a href={href(link.href)}>{link.label}</a>
                    </>
                  ))}
                  {person.officeAfter && <> {person.officeAfter}</>}
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    {sections.length > 0 && (
      <section class="section">
        <div class="shell">
          <div class="section-head">
            <h2>Course details</h2>
          </div>
          <div class="course-body">
            {sections.map((section) => (
              <div class="course-detail">
                <h3>{section.title}</h3>
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {section.list && (
                  <ul>
                    {section.list.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                {section.links?.map((link) => (
                  <p>
                    <a href={href(link.href)}>{link.label}</a>
                  </p>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="shell">
        <div class="section-head">
          <h2>Schedule</h2>
        </div>
        <div class="table-wrap">
          <table class="schedule">
            <thead>
              <tr>
                <th>Date</th>
                <th>Topic</th>
                <th>Materials</th>
                <th>Assignments</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((row) => (
                <tr>
                  <td>{row.date}</td>
                  <td>{row.topic}</td>
                  <td class="materials">
                    {row.materials?.map((material, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={href(material.href)}>{material.label}</a>
                      </>
                    ))}
                  </td>
                  <td class="note">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-head">
          <h2>Essential reads</h2>
        </div>
        <div class="readings">
          {readings.map((group) => (
            <div class="reading-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    {item.text}
                    {item.href && (
                      <>
                        {' '}
                        <a href={href(item.href)}>[link]</a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {previous && (
          <p class="course-foot" style="margin-top:2rem">
            Previous iteration: <a href={href(previous.href)}>{previous.label}</a>
          </p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Base>
