---
interface Props {
  label: string;
  title: string;
  lede?: string;
}

const { label, title, lede } = Astro.props;
---

<header class="page-head">
  <div class="shell">
    <span class="label">{label}</span>
    <h1 class="display">{title}</h1>
    {lede && <p class="intro">{lede}</p>}
    <slot />
  </div>
</header>
