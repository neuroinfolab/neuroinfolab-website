---
import { url } from '../lib/url';
import { ADDRESS, EMAIL, SCHOLAR, TWITTER, YOUTUBE, links } from '../data/lab';

const year = new Date().getFullYear();
const nav = [
  { href: '/research', label: 'Research' },
  { href: '/team', label: 'Team' },
  { href: '/publications', label: 'Publications' },
  { href: '/teaching', label: 'Teaching' },
  { href: '/join', label: 'Join us' },
];
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <p class="footer-mark">Neuroinformatics Lab</p>
        <p class="label" style="margin-top:0.6rem">NYU Tandon · Computer Science &amp; Engineering</p>
        <p class="footer-address" style="margin-top:0.9rem">{ADDRESS}</p>
      </div>

      <div>
        <h3>Explore</h3>
        <p>
          {nav.map((item, i) => (
            <>
              <a href={url(item.href)}>{item.label}</a>
              {i < nav.length - 1 && <br />}
            </>
          ))}
        </p>
      </div>

      <div>
        <h3>Contact</h3>
        <p>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a><br />
          <a href={SCHOLAR} target="_blank" rel="noopener">Google Scholar</a><br />
          <a href={TWITTER} target="_blank" rel="noopener">X / Twitter</a><br />
          <a href={YOUTUBE} target="_blank" rel="noopener">YouTube</a><br />
          <a href={links.vida} target="_blank" rel="noopener">VIDA Center</a>
        </p>
      </div>
    </div>

    <div class="footer-base">
      <span class="label">© {year} Neuroinformatics Lab</span>
      <span class="label">NIH/NIMH K99/R00 · 1K99MH128772</span>
    </div>
  </div>
</footer>
