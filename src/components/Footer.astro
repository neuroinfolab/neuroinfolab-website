---
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="logo-strip" aria-label="Affiliations and funding">
      <a href={url('/')} aria-label="Neuroinformatics Lab home">
        <img
          class="logo--on-dark"
          src={url('/img/logos/neuroinformatics-dark.png')}
          alt="Neuroinformatics Lab"
          height="36"
        />
        <img
          class="logo--on-light"
          src={url('/img/logos/neuroinformatics-light.png')}
          alt="Neuroinformatics Lab"
          height="36"
        />
      </a>
      <a href="https://vida.engineering.nyu.edu" target="_blank" rel="noopener noreferrer" aria-label="VIDA Center">
        <img
          class="logo--on-dark"
          src={url('/img/logos/vida-dark.png')}
          alt="Visualization Imaging and Data Analysis Center (VIDA)"
          height="36"
        />
        <img
          class="logo--on-light"
          src={url('/img/logos/vida-light.png')}
          alt="Visualization Imaging and Data Analysis Center (VIDA)"
          height="36"
        />
      </a>
      <a href="https://www.nimh.nih.gov/" target="_blank" rel="noopener noreferrer" aria-label="NIH National Institute of Mental Health">
        <img src={url('/img/logos/nih-nimh.jpg')} alt="NIH National Institute of Mental Health" height="36" />
      </a>
    </div>

    <div class="footer-grid">
      <div>
        <p class="footer-mark">Neuroinformatics Lab</p>
        <p class="label" style="margin-top:0.6rem">NYU Tandon · Computer Science &amp; Engineering</p>
      </div>

      <div>
        <h3>Visit</h3>
        <p>370 Jay Street, Room 1158<br />Brooklyn, NY 11201</p>
      </div>

      <div>
        <h3>Contact</h3>
        <p>
          <a href="mailto:ev2240@nyu.edu">ev2240@nyu.edu</a><br />
          <a href="https://scholar.google.com/citations?user=7GlElV0AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a><br />
          <a href="https://vida.engineering.nyu.edu" target="_blank" rel="noopener noreferrer">VIDA Center</a>
        </p>
      </div>

      <div>
        <h3>Follow</h3>
        <div class="social">
          <a
            href="https://twitter.com/erdem___varol"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            title="Twitter"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/channel/UC6aMrgW4-StJVg9YwUF0AiQ"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            title="YouTube"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-base">
      <span class="label">© {year} Neuroinformatics Lab</span>
      <span class="label">NIH/NIMH K99/R00 · 1K99MH128772</span>
    </div>
  </div>
</footer>
