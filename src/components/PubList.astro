---
import { formatAuthors } from '../data/lab';

interface Publication {
  year: string;
  title: string;
  authors: string;
  venue: string;
}

interface Props {
  groups: { year: string; items: Publication[] }[];
  compact?: boolean;
}

const { groups, compact = false } = Astro.props;
const yearId = (year: string) => `y${year.slice(0, 4)}`;
---

<div class:list={['pubs', { 'pubs--compact': compact }]}>
  {groups.map((group) => (
    <section class="pub-year-group" id={yearId(group.year)}>
      <h3 class="pub-year-head">
        {group.year}
        <span>{group.items.length} {group.items.length === 1 ? 'paper' : 'papers'}</span>
      </h3>
      {group.items.map((p) => (
        <article class="pub">
          <p class="pub-title">{p.title}</p>
          <span class="pub-venue">
            <span set:html={formatAuthors(p.authors)} />
            {p.venue && <> · {p.venue}</>}
          </span>
        </article>
      ))}
    </section>
  ))}
</div>
