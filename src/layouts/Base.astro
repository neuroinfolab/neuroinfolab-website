---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const locked = import.meta.env.PUBLIC_SITE_LOCKED === 'true';
const passcode = import.meta.env.SITE_PASSWORD ?? '';
const lockHash = locked && passcode ? createHash('sha256').update(passcode).digest('hex') : '';
---

<!doctype html>
<html lang="en" class:list={{ locked }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#101012" />
    {locked && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {locked && (
      <script is:inline>
        try {
          if (sessionStorage.getItem('lab-unlocked') === '1') {
            document.documentElement.classList.remove('locked');
          }
        } catch (e) {}
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    {locked && (
      <div class="gate" id="gate">
        <form class="gate-form" id="gate-form" data-hash={lockHash}>
          <span class="label">Restricted</span>
          <h1>Neuroinformatics Lab</h1>
          <p>Enter the passcode to continue.</p>
          <label class="label" for="code">Passcode</label>
          <input id="code" name="code" type="password" autocomplete="current-password" required />
          <button type="submit">Enter</button>
          <p class="gate-error" id="gate-error" role="alert"></p>
        </form>
      </div>
    )}

    <slot />

    <script>
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      }

      // A small, compositor-friendly parallax for framed portraits. The image
      // is oversized inside its frame and drifts a few pixels as it crosses
      // the viewport. Reduced-motion visitors get the static crop.
      const parallaxFrames = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (parallaxFrames.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;
        const paintParallax = () => {
          const viewport = window.innerHeight || 1;
          parallaxFrames.forEach((frame) => {
            const rect = frame.getBoundingClientRect();
            if (rect.bottom < -80 || rect.top > viewport + 80) return;
            const progress = (rect.top + rect.height / 2 - viewport / 2) / viewport;
            const image = frame.querySelector<HTMLElement>('img');
            if (image) image.style.transform = `translate3d(0, ${(progress * -22).toFixed(2)}px, 0) scale(1.06)`;
          });
          ticking = false;
        };
        const queueParallax = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(paintParallax);
        };
        window.addEventListener('scroll', queueParallax, { passive: true });
        window.addEventListener('resize', queueParallax);
        paintParallax();
      }

      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      menuBtn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      // Keep visitors on the site: every off-site link (and every PDF) opens
      // in a new tab. Same-page anchors and internal navigation stay put.
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
        try {
          const target = new URL(href, window.location.href);
          if (target.origin !== window.location.origin || target.pathname.toLowerCase().endsWith('.pdf')) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
        } catch {
          /* ignore malformed URLs */
        }
      });

      const gateForm = document.getElementById('gate-form') as HTMLFormElement | null;
      if (gateForm) {
        const error = document.getElementById('gate-error');
        gateForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const input = gateForm.querySelector<HTMLInputElement>('#code');
          const value = input?.value ?? '';
          const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
          const hex = Array.from(new Uint8Array(digest))
            .map((b) => b.toString(16).padStart(2, '0'))
            .join('');
          if (hex === gateForm.dataset.hash) {
            try {
              sessionStorage.setItem('lab-unlocked', '1');
            } catch (e) {}
            document.documentElement.classList.remove('locked');
            document.getElementById('gate')?.remove();
          } else if (error) {
            error.textContent = 'That passcode is not right.';
            if (input) {
              input.value = '';
              input.focus();
            }
          }
        });
      }
    </script>
  </body>
</html>
